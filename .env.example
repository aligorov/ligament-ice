# Доменное имя вашего сервера (realm)
REALM=remote.grando.app

# Email для автоматической регистрации и уведомлений Let's Encrypt (ACME)
ACME_EMAIL=admin@grando.app

# Внешний статический IPv4-адрес вашего сервера (обязателен для правильного STUN/TURN за NAT)
EXTERNAL_IP=YOUR_SERVER_PUBLIC_IPV4

# Учетные данные пользователя TURN
TURN_USER=ligament
TURN_PASSWORD=CHANGE_ME_SECURE_PASSWORD
